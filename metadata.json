---
permalink: /metadata.json
layout: null
sitemap: false
---
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ site.url }}/#website",
  "name": {{ site.title | jsonify }},
  "description": {{ site.description | strip_newlines | normalize_whitespace | jsonify }},
  "url": {{ site.url | jsonify }},
  "inLanguage": {{ site.locale | slice: 0, 2 | default: "en" | jsonify }},
  "publisher": {
    "@type": {{ site.social.type | default: "Organization" | jsonify }},
    "name": {{ site.social.name | default: site.title | jsonify }},
    "url": {{ site.url | jsonify }}
  }
}
